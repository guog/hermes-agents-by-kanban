# Copy this file to .env before the first docker compose up. Compose also passes
# this file into the container, so user settings and download mirrors stay here.
COMPOSE_PROJECT_NAME=hermes

# Official Hermes Agent image, fixed to the selected release tag.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.7.20

# Writable host directories and container runtime UID/GID.
HERMES_DATA_DIR=./data
PROJECTS_DIR=./projects
PUID=1000
PGID=1000

# Internal-network Dashboard. It is intentionally published on every host
# interface and uses one shared plaintext account for all LAN users.
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD='Hollysys#1234'
# Session signing value required by Hermes; this deployment does not treat it as
# a secret because it is intended only for the internal network.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=HollysysInternalDashboardSessionSecret2026

# Deterministic Hollysys Controller and reviewer/tester GitLab identity lists.
# Controller reuses the dispatcher group-level Maintainer token; deployment
# materializes the same value in data/controller/gitlab-token with mode 0600.
HOLLYSYS_GITLAB_HOST=
HOLLYSYS_GITLAB_ALLOWED_GROUPS=
HOLLYSYS_SPEC_REVIEWER_IDENTITIES=
HOLLYSYS_PLAN_REVIEWER_IDENTITIES=
HOLLYSYS_TASKS_REVIEWER_IDENTITIES=
HOLLYSYS_TESTER_IDENTITIES=
HOLLYSYS_CODE_REVIEWER_IDENTITIES=

# Python package indexes. Empty extra-index values prevent fallback.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_EXTRA_INDEX_URL=
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
UV_EXTRA_INDEX_URL=

# JavaScript package registries.
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com/
npm_config_registry=https://registry.npmmirror.com/
COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
PNPM_CONFIG_REGISTRY=https://registry.npmmirror.com/
YARN_NPM_REGISTRY_SERVER=https://registry.npmmirror.com/

# Node runtime downloads and node-gyp headers.
NVM_NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node
N_NODE_MIRROR=https://npmmirror.com/mirrors/node
npm_package_config_node_gyp_dist_url=https://npmmirror.com/mirrors/node
npm_config_disturl=https://npmmirror.com/mirrors/node

# Cypress, Playwright Chromium, Puppeteer and ChromeDriver binaries.
CYPRESS_DOWNLOAD_MIRROR=https://npmmirror.com/mirrors/cypress
CYPRESS_DOWNLOAD_PATH_TEMPLATE='https://npmmirror.com/mirrors/cypress/${version}/${platform}-${arch}/cypress.zip'
PLAYWRIGHT_CHROMIUM_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
PUPPETEER_CHROME_DOWNLOAD_BASE_URL=https://npmmirror.com/mirrors/chrome-for-testing
PUPPETEER_CHROME_HEADLESS_SHELL_DOWNLOAD_BASE_URL=https://npmmirror.com/mirrors/chrome-for-testing
PUPPETEER_DOWNLOAD_HOST=https://npmmirror.com/mirrors
CHROMEDRIVER_CDNBINARIESURL=https://npmmirror.com/mirrors/chrome-for-testing
CHROMEDRIVER_LEGACY_CDNURL=https://npmmirror.com/mirrors/chromedriver

# Electron and electron-builder binaries.
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
npm_config_electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# Native and auxiliary postinstall downloads. The Sharp setting serves Sharp
# 0.32 and older; modern Sharp binaries come from the npm registry above.
npm_config_sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips
SASS_BINARY_SITE=https://npmmirror.com/mirrors/node-sass
PRISMA_ENGINES_MIRROR=https://npmmirror.com/mirrors/prisma
SENTRYCLI_CDNURL=https://npmmirror.com/mirrors/sentry-cli

# Shared model-provider settings. Profile-specific GitLab and Feishu credentials
# remain in data/profiles/<profile>/.env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
NOUS_API_KEY=
