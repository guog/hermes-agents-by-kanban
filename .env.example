# Copy this file to .env and edit it before the first docker compose up.
COMPOSE_PROJECT_NAME=hermes

# Official Hermes Agent image, pinned to the reviewed Linux AMD64 manifest.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.7.20@sha256:a6ce64e2038867885c2c90f6602425e6e70293d5e6d952a0e603a99265e01c40

# Writable host directories mounted into the official image.
HERMES_DATA_DIR=./data
PROJECTS_DIR=./projects
PUID=1000
PGID=1000

# Dashboard is bound to host loopback. Use an SSH tunnel for remote access.
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Deterministic Hollysys controller. Store its dedicated Maintainer token only in
# data/controller/gitlab-token and chmod that file 600.
HOLLYSYS_GITLAB_HOST=
HOLLYSYS_GITLAB_ALLOWED_GROUPS=
HOLLYSYS_SPEC_REVIEWER_IDENTITIES=
HOLLYSYS_PLAN_REVIEWER_IDENTITIES=
HOLLYSYS_TASKS_REVIEWER_IDENTITIES=
HOLLYSYS_TESTER_IDENTITIES=
HOLLYSYS_CODE_REVIEWER_IDENTITIES=

# Shared model-provider credentials. Profile-specific GitLab and Feishu
# credentials must stay in data/profiles/<profile>/.env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
NOUS_API_KEY=
