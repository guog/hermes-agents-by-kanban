{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollysys.example/schemas/card-completion-v3.json",
  "$defs": {
    "Outcome": {
      "enum": [
        "pass",
        "fail",
        "scope_gap",
        "cancelled"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Stage": {
      "enum": [
        "spec-write",
        "spec-review",
        "plan-write",
        "plan-review",
        "tasks-write",
        "tasks-review",
        "implement",
        "test",
        "code-review"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "hollysys-controller/v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "run_key": {
      "pattern": "^hollysys-[a-z0-9]{20}$",
      "title": "Run Key",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "iteration": {
      "minimum": 1,
      "title": "Iteration",
      "type": "integer"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "project_id": {
      "exclusiveMinimum": 0,
      "title": "Project Id",
      "type": "integer"
    },
    "project_path": {
      "title": "Project Path",
      "type": "string"
    },
    "checkout": {
      "title": "Checkout",
      "type": "string"
    },
    "worktree": {
      "title": "Worktree",
      "type": "string"
    },
    "branch": {
      "title": "Branch",
      "type": "string"
    },
    "target_branch": {
      "title": "Target Branch",
      "type": "string"
    },
    "prd_path": {
      "title": "Prd Path",
      "type": "string"
    },
    "prd_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Prd Commit Sha",
      "type": "string"
    },
    "prd_mr_url": {
      "format": "uri",
      "minLength": 1,
      "title": "Prd Mr Url",
      "type": "string"
    },
    "kanban_card_id": {
      "pattern": "^t_[A-Za-z0-9_-]+$",
      "title": "Kanban Card Id",
      "type": "string"
    },
    "mr_iid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mr Iid"
    },
    "mr_url": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mr Url"
    },
    "head_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Head Sha"
    },
    "review_commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Commit Sha"
    },
    "artifact_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Digest"
    },
    "artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Paths",
      "type": "array"
    },
    "verification": {
      "items": {
        "type": "string"
      },
      "title": "Verification",
      "type": "array"
    },
    "gitlab_urls": {
      "items": {
        "format": "uri",
        "minLength": 1,
        "type": "string"
      },
      "title": "Gitlab Urls",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "scope_gap_target": {
      "anyOf": [
        {
          "enum": [
            "spec-write",
            "plan-write",
            "tasks-write"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Gap Target"
    },
    "residual_risk": {
      "items": {
        "type": "string"
      },
      "title": "Residual Risk",
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "run_key",
    "stage",
    "iteration",
    "outcome",
    "project_id",
    "project_path",
    "checkout",
    "worktree",
    "branch",
    "target_branch",
    "prd_path",
    "prd_commit_sha",
    "prd_mr_url",
    "kanban_card_id"
  ],
  "title": "CompletionMetadata",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "scope_gap"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "scope_gap_target",
          "issues"
        ],
        "properties": {
          "scope_gap_target": {
            "enum": [
              "spec-write",
              "plan-write",
              "tasks-write"
            ]
          },
          "issues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "cancelled"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "scope_gap_target": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "spec-review",
              "plan-review",
              "tasks-review"
            ]
          },
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "artifact_paths",
          "artifact_digest",
          "review_commit_sha"
        ],
        "properties": {
          "artifact_paths": {
            "type": "array",
            "minItems": 1
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "review_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "test",
              "code-review"
            ]
          },
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "mr_iid",
          "mr_url",
          "head_sha"
        ],
        "properties": {
          "mr_iid": {
            "type": "integer",
            "minimum": 1
          },
          "mr_url": {
            "type": "string",
            "format": "uri"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  ]
}
