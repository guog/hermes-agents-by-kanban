{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hollysys.example/schemas/card-completion-v7.json",
  "$defs": {
    "BaselineDisposition": {
      "enum": [
        "source",
        "reviewed",
        "forced_after_review_limit"
      ],
      "title": "BaselineDisposition",
      "type": "string"
    },
    "ChangeStrategy": {
      "enum": [
        "extend_existing",
        "modify_existing",
        "extend_and_modify"
      ],
      "title": "ChangeStrategy",
      "type": "string"
    },
    "ForcedAdvance": {
      "additionalProperties": false,
      "properties": {
        "review_limit": {
          "minimum": 1,
          "title": "Review Limit",
          "type": "integer"
        },
        "final_review_card_id": {
          "pattern": "^t_[A-Za-z0-9_-]+$",
          "title": "Final Review Card Id",
          "type": "string"
        },
        "final_review_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Final Review Url",
          "type": "string"
        },
        "decision_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Decision Url",
          "type": "string"
        },
        "baseline_commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Baseline Commit Sha",
          "type": "string"
        },
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Artifact Paths",
          "type": "array"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "key_decisions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Key Decisions",
          "type": "array"
        },
        "unresolved_findings": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Findings",
          "type": "array"
        },
        "residual_risks": {
          "items": {
            "type": "string"
          },
          "title": "Residual Risks",
          "type": "array"
        }
      },
      "required": [
        "review_limit",
        "final_review_card_id",
        "final_review_url",
        "decision_url",
        "baseline_commit_sha",
        "artifact_paths",
        "artifact_digest",
        "key_decisions"
      ],
      "title": "ForcedAdvance",
      "type": "object"
    },
    "GatePhase": {
      "enum": [
        "code",
        "migration",
        "deployment",
        "release"
      ],
      "title": "GatePhase",
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "pass",
        "fail",
        "cancelled"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "RepositoryEvidence": {
      "additionalProperties": false,
      "properties": {
        "repository_base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Repository Base Sha",
          "type": "string"
        },
        "inspected_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Inspected Paths",
          "type": "array"
        },
        "existing_capabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Existing Capabilities",
          "type": "array"
        },
        "change_strategy": {
          "$ref": "#/$defs/ChangeStrategy"
        },
        "reuse_decisions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reuse Decisions",
          "type": "array"
        }
      },
      "required": [
        "repository_base_sha",
        "inspected_paths",
        "existing_capabilities",
        "change_strategy",
        "reuse_decisions"
      ],
      "title": "RepositoryEvidence",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "spec-write",
        "spec-review",
        "plan-write",
        "plan-review",
        "tasks-write",
        "tasks-review",
        "implement",
        "test",
        "code-review"
      ],
      "title": "Stage",
      "type": "string"
    },
    "TestDisposition": {
      "enum": [
        "executed",
        "skipped_unavailable"
      ],
      "title": "TestDisposition",
      "type": "string"
    },
    "WorkMode": {
      "enum": [
        "normal",
        "finalization"
      ],
      "title": "WorkMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "hollysys-controller/v3",
      "title": "Protocol Version",
      "type": "string"
    },
    "run_key": {
      "pattern": "^hollysys-[a-z0-9]{20}$",
      "title": "Run Key",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "iteration": {
      "minimum": 1,
      "title": "Iteration",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/WorkMode",
      "default": "normal"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "project_id": {
      "exclusiveMinimum": 0,
      "title": "Project Id",
      "type": "integer"
    },
    "project_path": {
      "title": "Project Path",
      "type": "string"
    },
    "checkout": {
      "title": "Checkout",
      "type": "string"
    },
    "worktree": {
      "title": "Worktree",
      "type": "string"
    },
    "branch": {
      "title": "Branch",
      "type": "string"
    },
    "target_branch": {
      "title": "Target Branch",
      "type": "string"
    },
    "prd_path": {
      "title": "Prd Path",
      "type": "string"
    },
    "prd_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Prd Commit Sha",
      "type": "string"
    },
    "prd_blob_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Prd Blob Sha",
      "type": "string"
    },
    "prd_mr_url": {
      "format": "uri",
      "minLength": 1,
      "title": "Prd Mr Url",
      "type": "string"
    },
    "kanban_card_id": {
      "pattern": "^t_[A-Za-z0-9_-]+$",
      "title": "Kanban Card Id",
      "type": "string"
    },
    "mr_iid": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mr Iid"
    },
    "mr_url": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mr Url"
    },
    "head_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Head Sha"
    },
    "artifact_commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Commit Sha"
    },
    "artifact_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Digest"
    },
    "artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Paths",
      "type": "array"
    },
    "baseline_disposition": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineDisposition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "forced_advance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForcedAdvance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repository_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "test_disposition": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestDisposition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "skip_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skip Reason"
    },
    "verification": {
      "items": {
        "type": "string"
      },
      "title": "Verification",
      "type": "array"
    },
    "gitlab_urls": {
      "items": {
        "format": "uri",
        "minLength": 1,
        "type": "string"
      },
      "title": "Gitlab Urls",
      "type": "array"
    },
    "key_decisions": {
      "items": {
        "type": "string"
      },
      "title": "Key Decisions",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "residual_risk": {
      "items": {
        "type": "string"
      },
      "title": "Residual Risk",
      "type": "array"
    },
    "gate_phase": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatePhase"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Contract Refs",
      "type": "array"
    },
    "requirement_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Requirement Ids",
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "run_key",
    "stage",
    "iteration",
    "outcome",
    "project_id",
    "project_path",
    "checkout",
    "worktree",
    "branch",
    "target_branch",
    "prd_path",
    "prd_commit_sha",
    "prd_blob_sha",
    "prd_mr_url",
    "kanban_card_id"
  ],
  "title": "CompletionMetadata",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "fail"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "issues"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "spec-review",
              "plan-review",
              "tasks-review"
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "artifact_paths",
          "artifact_digest",
          "artifact_commit_sha"
        ],
        "properties": {
          "artifact_paths": {
            "type": "array",
            "minItems": 1
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifact_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "spec-review",
              "plan-review",
              "tasks-review"
            ]
          },
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "baseline_disposition"
        ],
        "properties": {
          "baseline_disposition": {
            "const": "reviewed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "test",
              "code-review"
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "mr_iid",
          "mr_url",
          "head_sha"
        ],
        "properties": {
          "mr_iid": {
            "type": "integer",
            "minimum": 1
          },
          "mr_url": {
            "type": "string",
            "format": "uri"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "test"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "test_disposition"
        ],
        "properties": {
          "test_disposition": {
            "enum": [
              "executed",
              "skipped_unavailable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "spec-write",
              "plan-write",
              "tasks-write",
              "implement"
            ]
          },
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "stage",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "repository_evidence"
        ],
        "properties": {
          "repository_evidence": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "test"
          },
          "test_disposition": {
            "const": "skipped_unavailable"
          }
        },
        "required": [
          "stage",
          "test_disposition"
        ]
      },
      "then": {
        "required": [
          "outcome",
          "skip_reason",
          "verification",
          "residual_risk"
        ],
        "properties": {
          "outcome": {
            "const": "pass"
          },
          "skip_reason": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "array",
            "minItems": 1
          },
          "residual_risk": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "finalization"
          },
          "outcome": {
            "const": "pass"
          }
        },
        "required": [
          "mode",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "artifact_paths",
          "artifact_digest",
          "artifact_commit_sha",
          "baseline_disposition",
          "forced_advance",
          "mr_iid",
          "mr_url"
        ],
        "properties": {
          "artifact_paths": {
            "type": "array",
            "minItems": 1
          },
          "baseline_disposition": {
            "const": "forced_after_review_limit"
          },
          "forced_advance": {
            "type": "object"
          }
        }
      }
    }
  ]
}
