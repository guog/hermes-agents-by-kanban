#!/bin/sh
set -eu

action=${1:-}
[ "$action" = "get" ] || exit 0

protocol=
host=
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=${value%%:*} ;;
  esac
done

[ "$protocol" = "https" ] || exit 0
[ "$host" = "green-git.hollysys.net" ] || exit 0

if [ -z "${GITLAB_TOKEN:-}" ]; then
  echo "hollysys-git-credential error=missing_gitlab_token" >&2
  exit 65
fi

printf 'username=oauth2\n'
printf 'password=%s\n' "$GITLAB_TOKEN"
